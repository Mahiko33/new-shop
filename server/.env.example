# Copy this file, rename the copy to ".env", and fill in your values.

# Port for the website: http://localhost:3000
PORT=3000

# Any long random text. Keeps logins secure. Change it.
SESSION_SECRET=change-this-to-a-long-random-sentence

# ---------- Microsoft SQL Server ----------
DB_SERVER=localhost
DB_NAME=WashTrack

# Use EITHER a port (when TCP/IP is enabled on port 1433) ...
DB_PORT=1433
# ... OR the instance name (SQL Server Express is usually SQLEXPRESS).
# If you use DB_INSTANCE, the "SQL Server Browser" service must be running.
# DB_INSTANCE=SQLEXPRESS

# The login created by database/schema.sql (change both places if you change it)
DB_USER=washtrack_app
DB_PASSWORD=WashTrack#2026

# For SQL Server on your own PC keep these as they are
DB_ENCRYPT=false
DB_TRUST_CERT=true
